{
    "name": "sveda-ai/laravel-sdk",
    "description": "Embed a Sveda AI agent in Laravel (sessions + host MCP). https://sveda.dev/docs/hosts/laravel",
    "type": "library",
    "license": "AGPL-3.0-only",
    "keywords": ["laravel", "sveda", "ai", "agent", "copilot", "mcp", "sdk"],
    "homepage": "https://sveda.dev/docs/hosts/laravel",
    "authors": [
        {
            "name": "Neresson",
            "homepage": "https://github.com/neresson",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://sveda.dev/docs/hosts/laravel",
        "issues": "https://github.com/neresson/sveda-laravel-sdk/issues",
        "source": "https://github.com/neresson/sveda-laravel-sdk"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../sveda-php-sdk"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "laravel/mcp": "^0.8.2",
        "laravel/sanctum": "^4.0",
        "sveda-ai/php-sdk": "^0.3 || dev-main"
    },
    "require-dev": {
        "laravel/framework": "^12.0 || ^13.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Sveda\\LaravelClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sveda\\LaravelClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sveda\\LaravelClient\\SvedaClientServiceProvider"
            ],
            "aliases": {
                "SvedaClient": "Sveda\\LaravelClient\\Facades\\SvedaClient"
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
